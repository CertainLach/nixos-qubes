#!/bin/sh

set -eu

usage() {
	echo "Usage: nixos-qubes-install-template-url <template-name> <rpm-url> [<gpg-key-path>]" >&2
	echo "" >&2
	echo "Downloads a template RPM from URL, verifies its signature, and installs it." >&2
	echo "" >&2
	echo "Arguments:" >&2
	echo "  gpg-key-path  Path to GPG public key for RPM signature verification." >&2
	echo "                If not specified, signature verification is skipped (unsafe)." >&2
	echo "" >&2
	echo "Example:" >&2
	echo "  nixos-qubes-install-template-url fedora-41-xfce \\" >&2
	echo "    https://ftp.qubes-os.org/.../qubes-template-fedora-41-xfce-4.3.0-202504081605.noarch.rpm \\" >&2
	echo "    /etc/qubes/repo-templates/keys/RPM-GPG-KEY-qubes-4.3-primary" >&2
	exit 1
}

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
	usage
fi

template_name=$1
rpm_url=$2
gpg_key=${3:-}

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT

rpm_file="$dir/template.rpm"
echo "Downloading $rpm_url..."
curl --fail --location --progress-bar -o "$rpm_file" "$rpm_url"

if [ -n "$gpg_key" ]; then
	echo "Verifying RPM signature..."
	rpmdb_dir="$dir/rpmdb"
	rpmkeys --dbpath="$rpmdb_dir" --import "$gpg_key"
	if ! rpmkeys --dbpath="$rpmdb_dir" \
		--define='_pkgverify_level all' \
		--define='_pkgverify_flags 0x0' \
		--checksig "$rpm_file"; then
		echo "ERROR: RPM signature verification failed!" >&2
		exit 1
	fi
	echo "Signature OK."
else
	echo "WARNING: No GPG key provided, skipping signature verification." >&2
fi

echo "Installing template '$template_name'..."
exec nixos-qubes-install-template-rpm "$template_name" "$rpm_file"
