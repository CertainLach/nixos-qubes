#!/bin/sh

set -eu

usage() {
	echo "Usage: nixos-qubes-install-kernel-rpm <name> <kernelver> <fedoraver> <kernel-rpm> <modules-rpm>" >&2
	echo "" >&2
	echo "Installs a Qubes VM kernel from local RPM files." >&2
	echo "" >&2
	echo "Arguments:" >&2
	echo "  name         Name for the installed kernel (e.g. '6.12.64-1.fc41')" >&2
	echo "  kernelver    Kernel version (e.g. '6.12.64-1')" >&2
	echo "  fedoraver    Fedora version (e.g. 'fc41')" >&2
	echo "  kernel-rpm   Path to kernel-qubes-vm RPM" >&2
	echo "  modules-rpm  Path to kernel-modules RPM" >&2
	exit 1
}

if [ "$#" -ne 5 ]; then
	usage
fi

name=$1
kernelver=$2
fedoraver=$3
rpmkernel=$4
rpmmodules=$5

destdir=/var/lib/qubes/vm-kernels/$name

dir=$(mktemp -d)
cd "$dir" || exit 1

rpmextract "$rpmkernel"
rpmextract "$rpmmodules"

kerneldir=$dir/var/lib/qubes/vm-kernels/$kernelver.$fedoraver
moduledir=$dir/lib/modules/$kernelver.qubes.$fedoraver.$(uname -m)

ls -lah "$dir/"

if ! test -f "$kerneldir/vmlinuz"; then
	ls "$kerneldir/../"
	ls "$kerneldir"
	echo "kernel with specified name is not found in kernel rpm"
	exit 1
fi
if ! test -f "$moduledir/modules.builtin"; then
	echo "modules dir with specified name is not found in modules rpm"
	exit 1
fi

# Image must contain the version-named subdirectory, not bare files.
imgroot="$dir/imgroot"
mkdir -p "$imgroot"
cp -a "$moduledir" "$imgroot/"

# Set SELinux labels so modules are accessible under enforcing SELinux in VMs
find "$imgroot" -exec setfattr -n security.selinux \
	-v "system_u:object_r:modules_object_t:s0" {} \;

# Match upstream qubes-prepare-vm-kernel: ext3 with minimal features,
# create at 768M then shrink with resize2fs.
truncate -s 768M modules.img
mkfs.ext3 -q -F \
	-Enum_backup_sb=0,root_owner=0:0,no_copy_xattrs \
	-d "$imgroot" modules.img
e2fsck -pDf modules.img >/dev/null || true
resize2fs -fM modules.img >/dev/null

mv modules.img "$kerneldir/"

rsync -arv "$kerneldir/" "$destdir"
