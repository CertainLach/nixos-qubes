+#!/usr/bin/env bash
 
 # Misc dom0 startup setup
 
 %out%/lib/qubes/fix-dir-perms.sh
-DOM0_MAXMEM=$(/usr/sbin/xl list 0 | tail -1 | awk '{ print $3 }')
